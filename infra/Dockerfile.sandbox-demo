# FlareDispatch sandbox image — full variant: the lean image PLUS the
# bundled `demo-agent` CLI. The container class the `product-demo` run
# acquires (RunSandbox, the default image) builds from THIS file
# (`wrangler.jsonc` `containers[].image`); the lean classes build from
# `infra/Dockerfile.sandbox`. Keeping the agent layer in its own opt-in file
# (rather than an ARG in the shared one) means a lean class build never pulls
# the node builder stage or ships the bundle.
#
# The @cloudflare/sandbox SDK's Sandbox Durable Object speaks an HTTP/RPC
# protocol to a server baked into the container, so the image MUST derive from
# the matching cloudflare/sandbox base (a bare node image has no sandbox
# server). Pin the tag to @cloudflare/sandbox in package.json and bump both
# together.

# ── demo-agent builder stage ────────────────────────────────────────────────
#
# The `product-demo` run shells out to the bundled `demo-agent` CLI for every
# step; without it every `sandbox.exec` fails exit 127 ("No such file or
# directory"). This stage bundles `packages/demo-agent` FROM THIS REPO — the
# old `recipes/product-demo/Dockerfile.example` sparse-cloned the upstream
# GitHub URL and that must not come along into an in-repo build.
#
# REQUIRES the repo root as the docker build context: the class that builds
# from this file must set `containers[].image_build_context` to `"."` in
# wrangler.jsonc — wrangler's container build defaults the context to the
# Dockerfile's own directory, and every COPY below resolves against the
# context, not against the checkout.
#
# The COPY set is the minimal workspace slice the filtered frozen install
# needs (root manifests + the two packages). `packages/bedrock-sigv4` MUST be
# included: it is the agent's `workspace:*` dependency, and pnpm can only
# link a workspace member whose directory is present — with it missing, pnpm
# silently leaves the dep dangling and tsdown externalizes the import, so the
# bundle `require`s a package that will not exist in the runtime image.
FROM node:22-bookworm-slim AS demo-agent-builder
ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@11.1.3 --activate
WORKDIR /build
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY packages/demo-agent packages/demo-agent
COPY packages/bedrock-sigv4 packages/bedrock-sigv4
RUN set -eux; \
    pnpm install --frozen-lockfile --filter @fractalboxdev/flare-dispatch-demo-agent; \
    pnpm --filter @fractalboxdev/flare-dispatch-demo-agent build

FROM docker.io/cloudflare/sandbox:0.10.1

# Corepack is the standard bootstrap for repos that pin `"packageManager"`.
# The sandbox base ships Node 22 without Corepack on PATH, so install the tested
# release and activate its pnpm/Yarn shims for both explicit and bare commands.
RUN npm install -g corepack@0.35.0 && corepack enable

# ── Native build toolchain (gated by the WITH_BUILD_TOOLS build arg) ────────
#
# The lean base has NO C compiler. Any `offload-test` suite that compiles
# native code in the sandbox needs a `cc`/linker — most commonly Rust (`rustc`
# shells out to `cc` to link every binary) and node-gyp addons (make + g++).
# Without it a native suite dies at link with `error: linker 'cc' not found` —
# green on the author's machine, red in the sandbox, deterministically.
#
# Default off so the image stays lean; a consumer flips it per container
# class in wrangler.jsonc — `image_vars: { "WITH_BUILD_TOOLS": "true" }`.
# `build-essential` pulls gcc/g++/make/libc6-dev; `pkg-config` is the tiny,
# near-universal gateway for `*-sys` crates. A suite needing a specific system
# lib (e.g. `libssl-dev`) appends it in its own run command.
ARG WITH_BUILD_TOOLS=false
RUN if [ "$WITH_BUILD_TOOLS" = "true" ]; then \
      set -eux; \
      export DEBIAN_FRONTEND=noninteractive; \
      apt-get update; \
      apt-get install -y --no-install-recommends build-essential pkg-config xz-utils; \
      rm -rf /var/lib/apt/lists/*; \
      cc --version; \
    else \
      echo "WITH_BUILD_TOOLS=false — no native toolchain baked. Lean image."; \
    fi

# ── shellcheck (gated by the WITH_BUILD_TOOLS build arg) ────────────────────
#
# A run that lints shell scripts finds `shellcheck` on PATH. The release
# archive for the build architecture is pinned by SHA-256 and only the binary
# is extracted; `xz-utils` comes from the build-tools layer above.
ARG SHELLCHECK_VERSION=v0.10.0
RUN if [ "$WITH_BUILD_TOOLS" = "true" ]; then \
      set -eux; \
      arch="$(uname -m)"; \
      case "$arch" in \
        x86_64)  sha256=6c881ab0698e4e6ea235245f22832860544f17ba386442fe7e9d629f8cbedf87 ;; \
        aarch64) sha256=324a7e89de8fa2aed0d0c28f3dab59cf84c6d74264022c00c22af665ed1a09bb ;; \
        *) echo "shellcheck: unsupported architecture $arch" >&2; exit 1 ;; \
      esac; \
      archive="/tmp/shellcheck-${SHELLCHECK_VERSION}.linux.${arch}.tar.xz"; \
      curl -fsSL -o "$archive" \
        "https://github.com/koalaman/shellcheck/releases/download/${SHELLCHECK_VERSION}/shellcheck-${SHELLCHECK_VERSION}.linux.${arch}.tar.xz"; \
      echo "${sha256}  ${archive}" | sha256sum -c -; \
      tar -xJf "$archive" --strip-components=1 -C /usr/local/bin \
        "shellcheck-${SHELLCHECK_VERSION}/shellcheck"; \
      rm -f "$archive"; \
      shellcheck --version; \
    else \
      echo "WITH_BUILD_TOOLS=false — no shellcheck baked. Lean image."; \
    fi

# ── Rust toolchain (gated by the WITH_RUST build arg) ───────────────────────
#
# A webhook-mode `offload-test` command like `cargo test --workspace` has no
# GitHub-Actions setup step to install a toolchain, and per-run rustup installs
# would pay the download on every PR — so Rust is baked at image build time
# behind a flag. Installed system-wide (not $HOME) so it is on PATH for
# whatever user the sandbox server execs as; RUSTUP_HOME/CARGO_HOME are
# world-readable so a non-root exec can still resolve the toolchain. rustup
# itself stays available for per-run `rustup target add …` in a run command.
# `stable` floats by design: the image is rebuilt on every dispatcher deploy,
# and a consumer that needs a pinned toolchain pins it in its own run command.
# Requires WITH_BUILD_TOOLS=true to be useful — rustc cannot link without cc.
ARG WITH_RUST=false
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN if [ "$WITH_RUST" = "true" ]; then \
      set -eux; \
      curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal \
        --default-toolchain stable --target wasm32-wasip2 --no-modify-path; \
      chmod -R a+rX "$RUSTUP_HOME" "$CARGO_HOME"; \
      cargo --version; rustc --version; \
    else \
      echo "WITH_RUST=false — no Rust toolchain baked. Lean image."; \
    fi

# ── demo-agent layer ────────────────────────────────────────────────────────
#
# The `product-demo` run's bundled CLI (record start/stop, play, gif,
# write-prior — see packages/demo-agent). Build-time smoke (`demo-agent
# --help`) fails the image build on a broken bundle — the old
# Dockerfile.example's guarantee, kept.
COPY --from=demo-agent-builder /build/packages/demo-agent/dist/demo-agent.cjs /usr/local/bin/demo-agent
RUN chmod +x /usr/local/bin/demo-agent \
    && demo-agent --help > /dev/null
