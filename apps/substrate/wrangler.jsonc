{
  // flare-dispatch substrate — its own worker, frozen at this name from the
  // first BYOC deploy (specs/platform.md). Structural reason it is separate:
  // container DO classes live in whichever worker defines them, and deploying
  // that worker churns running containers — product iteration on the
  // dispatcher (or fractalbot) must never kill long-lived work mid-run.
  //
  // Deploy order per org: this worker FIRST (consumers' service bindings
  // require it), then the dispatcher; fractalbot binds from its own repo with
  //   services: [{ binding: "SUBSTRATE", service: "flare-dispatch-substrate",
  //                entrypoint: "FractalbotFacade" }]
  //
  // Account-specific values below are placeholders marked `operator overlay`.
  // A deploying org replaces this whole file with its own copy carrying the
  // real ones; the deploy workflow writes it from a repository secret. Locally,
  // keep that copy as the gitignored wrangler.overlay.local.jsonc beside this
  // file and pass it with `-c`.
  //
  // Provisioning, once per account:
  //   wrangler d1 create flare-dispatch-substrate   # id → operator overlay
  //   wrangler r2 bucket create flare-dispatch-substrate
  // then set the admission-ticket signing secret src/secrets.ts names.
  // Migrations are applied by the deploy workflow, not by hand.
  //
  // A deploy is not finished until the canary passes: `POST /canary` proves a
  // container fetch to an unlisted host still dies 520 (ADR-0011), and
  // `/health` answers 503 `unverified` until it does.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "flare-dispatch-substrate",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true },
  "keep_vars": true,

  "vars": {
    // Idle window before a finished container sleeps (see sandbox-do.ts).
    "SANDBOX_SLEEP_AFTER": "10m",
    // Account Containers headroom the pool cap-sum must fit while the
    // dispatcher still runs its own fleet (pools.ts validatePoolCaps).
    "CONTAINERS_CEILING": "16",
  },

  // Identifies the deployed build. A canary verdict is keyed to it, so
  // "verified" means verified for the code actually running rather than for
  // whatever last carried this semver (src/verify/store-d1.ts).
  "version_metadata": { "binding": "VERSION_METADATA" },

  // Two Dockerfiles across the four classes, both the substrate's OWN and both
  // on the `@cloudflare/sandbox` version this worker imports (0.12.4) — never
  // the dispatcher's Dockerfile.sandbox, which stays on its 0.10.1. The
  // in-image server and the Durable Object SDK are one protocol's two halves;
  // a mismatched pair fails at exec, not at deploy.
  //
  // `lean`/`browser`/`agent` share Dockerfile.substrate with per-class
  // `image_vars` gating its optional layers (ADR-0010: named image classes).
  // `task` has its own, Dockerfile.task, off the `-python` base with the
  // OpenCode harness, git-lfs, python3 + venv, pnpm and ripgrep baked in.
  //
  // `max_instances` here and `POOL_CAPS_DEFAULT` in src/admission/pools.ts are
  // the same partition written twice — the platform's physical cap and the
  // gate's logical one. container-config.test.ts fails when they diverge: a
  // logical cap above the physical one admits work the platform then refuses.
  "containers": [
    {
      "class_name": "SubstrateSandboxLean",
      "image": "../../infra/Dockerfile.substrate",
      "instance_type": "standard-2",
      "max_instances": 6,
    },
    {
      "class_name": "SubstrateSandboxBrowser",
      "image": "../../infra/Dockerfile.substrate",
      "image_vars": { "WITH_BROWSER": "true" },
      "instance_type": "standard-2",
      "max_instances": 3,
    },
    {
      "class_name": "SubstrateSandboxAgent",
      "image": "../../infra/Dockerfile.substrate",
      "image_vars": { "WITH_BUILD_TOOLS": "true" },
      "instance_type": "standard-3",
      "max_instances": 3,
    },
    {
      // standard-3 (2 vCPU / 8 GiB): a task installs one repository's
      // dependencies and runs its suite, which is heavier than the lean CI
      // executor's checkout-and-diff but nothing like the dispatcher's
      // standard-4 `RunSandbox`, whose size is set by cold `cargo test` over a
      // large dep graph. The harness process sits alongside the suite in that
      // memory; standard-2's 6 GiB is where a JS test runner forking per core
      // starts trading.
      //
      // max_instances 4 is what today's ceiling allows, not what the pool
      // wants: the four caps already sum to exactly CONTAINERS_CEILING (16),
      // so raising `task` now means taking instances off lean/browser/agent
      // while the dispatcher still runs its own 40-instance fleet against the
      // same account. Four concurrent containers covers the current
      // single-workspace load, since one task per conversation is a consumer
      // rule enforced ahead of this gate. POST-DRAIN TARGET: 12, once the
      // dispatcher's classes are drained and deleted and the substrate's
      // ceiling rises to the account's — that lands roughly a fifth of the
      // freed headroom on interactive work and leaves the rest for the CI
      // pools the drain moves onto `lean`.
      "class_name": "SubstrateSandboxTask",
      "image": "../../infra/Dockerfile.task",
      "instance_type": "standard-3",
      "max_instances": 4,
    },
  ],

  "durable_objects": {
    "bindings": [
      { "name": "SANDBOX_LEAN", "class_name": "SubstrateSandboxLean" },
      { "name": "SANDBOX_BROWSER", "class_name": "SubstrateSandboxBrowser" },
      { "name": "SANDBOX_AGENT", "class_name": "SubstrateSandboxAgent" },
      { "name": "SANDBOX_TASK", "class_name": "SubstrateSandboxTask" },
    ],
  },

  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": [
        "SubstrateSandboxLean",
        "SubstrateSandboxBrowser",
        "SubstrateSandboxAgent",
        "SubstrateSandboxTask",
      ],
    },
  ],

  "r2_buckets": [
    { "binding": "BACKUP_BUCKET", "bucket_name": "flare-dispatch-substrate" },
  ],

  "d1_databases": [
    {
      "binding": "ADMISSION_DB",
      "database_name": "flare-dispatch-substrate",
      // Operator overlay.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
}
